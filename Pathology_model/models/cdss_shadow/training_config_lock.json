                   "cohort_labeled_n": 55, "labels_source": "descriptor_labels.csv (fibrosis/atrophy/inflammation Banff ordinal)"},
  "intervention": {"change": "TaskAttentionMIL.encoders 에 nn.LayerNorm(dim) 추가", "everything_else": "동일(불변)"},
